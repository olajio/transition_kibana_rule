# LOOKUP JOIN variant that uses the consolidated source-of-truth index
# kibana_sdp_amdb_enrich (keyword-mapped, index.mode: lookup) instead of the
# original text+.keyword kibana_sdp_amdb.
#
# Differences from 10008_single_stage, all because hostname is now a plain
# keyword rather than a text field with a .keyword multi-field:
#   - RENAME host.hostname AS hostname        (was: AS hostname.keyword)
#   - LOOKUP JOIN kibana_sdp_amdb_enrich ON hostname   (was: kibana_sdp_amdb ON hostname.keyword)
#   - STATS ... BY hostname, ...              (was: BY hostname.keyword, ...)
#   - action template reads _source.hostname  (was: _source.hostname.keyword)
# The emitted ticket values are identical to 10008_single_stage; only the
# internal _source key name changes.
#
# Like 10008_single_stage this is a LOOKUP JOIN rule, so kibana_sdp_amdb_enrich
# must exist ON prod (populated) -- see kibana_sdp_amdb_enrich_index. It reads
# the index live: no enrich policy, no _execute step.
#
POST kbn:/api/alerting/rule/10ddef3e-4b27-49dc-ab82-41490dfe16da
{
  "name": "ITSMA Test 10008 - System CPU Utilization > 98% (kibana_sdp_amdb_enrich)",
  "tags": [
    "ITSMA",
    "Test",
    "Threshold rule",
    "10008",
    "CPU",
    "Single stage",
    "LOOKUP JOIN",
    "kibana_sdp_amdb_enrich"
  ],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": {
    "interval": "5m"
  },
  "params": {
    "searchType": "esqlQuery",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "esqlQuery": {
      "esql": "FROM prod:metricbeat-*\n| WHERE @timestamp > NOW() - 5 minutes\n| EVAL event_dataset = event.dataset::keyword,\n       cpu_pct       = system.cpu.total.norm.pct::double,\n       hostname      = host.hostname::keyword,\n       client_code   = labels.client_code::keyword,\n       app_code      = labels.app_code::keyword\n| WHERE event_dataset == \"system.cpu\" AND cpu_pct IS NOT NULL\n| LOOKUP JOIN kibana_sdp_amdb_enrich ON hostname\n| MV_EXPAND group\n| WHERE group == \"10008\" AND alert_status == \"enabled\"\n| STATS avg_cpu = AVG(cpu_pct) * 100 BY hostname, client_code, app_code\n| WHERE avg_cpu > 98\n| EVAL current_value = ROUND(avg_cpu, 2)\n| RENAME client_code AS labels.client_code, app_code AS labels.app_code\n| DROP avg_cpu\n| LIMIT 10000\n"
    },
    "aggType": "count",
    "groupBy": "row",
    "termSize": 5,
    "sourceFields": [],
    "timeField": "@timestamp",
    "excludeHitsFromPreviousRun": true
  },
  "artifacts": {
    "dashboards": [],
    "investigation_guide": {
      "blob": ""
    }
  },
  "actions": [
    {
      "group": "query matched",
      "id": "69fdac41-8a5e-483d-a506-19660d8550eb",
      "params": {
        "documents": [
          {
            "target": "{{context.hits.0._source.hostname}}",
            "event_type": "10008",
            "event_uuid": "on-prem_10008_{{context.hits.0._source.hostname}}",
            "alarm_name": "10008 - CPU Utilization > 98%",
            "trace": {
              "id": "{{alert.uuid}}"
            },
            "tags_to_exclude": "NA",
            "cloud": {
              "region": "NA",
              "account": {
                "name": "NA",
                "id": "NA"
              }
            },
            "labels": {
              "client_code": "{{context.hits.0._source.labels.client_code}}"
            },
            "@timestamp": "{{date}}",
            "amdb_link": "https://hedgeservcorp.sharepoint.com/sites/globaltechnology/amdb/sitepages/10008---system-cpu-utilization---98-.aspx?web=1",
            "dashboard_link": "https://287d86a4b1184182b340bd5074cdfd7e.us-east-1.aws.found.io:9243/s/information-technology/app/r/s/wmCdY",
            "service": {
              "type": "kibana_alerts",
              "name": "cpu_utilization"
            },
            "alarm_tags": {
              "hs:app:maintenance-window": "true",
              "hs:std:app-name": "NA",
              "hs:app:amdb": "10008",
              "hs:app:sdp-priority": "2 - High",
              "hs:std:svc-operator": "NA",
              "hs:std:svc-software-owner": "NA",
              "hs:app:monitored": "true",
              "hs:std:app-code": "{{context.hits.0._source.labels.app_code}}",
              "hs:app:ticket-group": "Monitoring and Analytics - Testing"
            },
            "alarm_reason": "Average CPU utilization over the last 5 minutes is {{context.hits.0._source.current_value}}"
          }
        ]
      },
      "frequency": {
        "notify_when": "onActiveAlert",
        "throttle": null,
        "summary": false
      },
      "uuid": "0c97743f-92b7-4af1-bafb-a935f8bb0156"
    }
  ],
  "alert_delay": {
    "active": 1
  }
}
