POST kbn:/api/alerting/rule/0f7b2449-d7fe-479a-ad04-4e958865746d
{
  "name": "ITSMA Test 10008 - System CPU Utilization > 98%",
  "tags": [
    "ITSMA",
    "Test",
    "Threshold rule",
    "10008",
    "CPU",
    "Single stage",
    "LOOKUP JOIN"
  ],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": {
    "interval": "5m"
  },
  "params": {
    "searchType": "esqlQuery",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "esqlQuery": {
      "esql": "FROM prod:metricbeat-*, prod:-metricbeat-7*\n| WHERE event.dataset == \"system.cpu\" AND @timestamp > NOW() - 5 minutes\n| RENAME host.hostname AS hostname.keyword\n| LOOKUP JOIN kibana_sdp_amdb ON hostname.keyword\n| MV_EXPAND group\n| WHERE group == \"10008\" AND alert_status == \"enabled\"\n| STATS avg_cpu = AVG(system.cpu.total.norm.pct) * 100 BY hostname.keyword, labels.client_code, labels.app_code\n| WHERE avg_cpu > 98\n| EVAL current_value = ROUND(avg_cpu, 2)\n| DROP avg_cpu\n| LIMIT 10000\n"
    },
    "aggType": "count",
    "groupBy": "row",
    "termSize": 5,
    "sourceFields": [],
    "timeField": "@timestamp",
    "excludeHitsFromPreviousRun": true
  },
  "artifacts": {
    "dashboards": [],
    "investigation_guide": {
      "blob": ""
    }
  },
  "actions": [
    {
      "group": "query matched",
      "id": "69fdac41-8a5e-483d-a506-19660d8550eb",
      "params": {
        "documents": [
          {
            "target": "{{context.hits.0._source.hostname.keyword}}",
            "event_type": "10008",
            "event_uuid": "on-prem_10008_{{context.hits.0._source.hostname.keyword}}",
            "alarm_name": "10008 - CPU Utilization > 98%",
            "trace": {
              "id": "{{alert.uuid}}"
            },
            "tags_to_exclude": "NA",
